build/
dist/
*.egg-info/
__pycache__/
*.py
*.pyd
*.pyo
*.pyc
*.o
*.obj
*.dll
*.def
*.lib
*.so
*.dylib
*.a

# IDE files
.vscode/
.idea/
*.swp
*.swo

