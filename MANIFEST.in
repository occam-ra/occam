# MANIFEST.in - Aggressively exclude all .py files except __init__.py

# Include ONLY the essential files
include README.md
include LICENSE
include setup.py

# Include package essentials
include pyoccam/__init__.py
include pyoccam/dementia05.txt
include pyoccam/landslides.txt
include pyoccam/*.dll
include pyoccam/*.pyd

# Source for building
include pyoccam/pyoccam_pybind11.cpp
recursive-include cpp *.cpp
recursive-include include *.h

# AGGRESSIVE EXCLUSION - exclude ALL other Python files
global-exclude pyoccam/[!_]*.py
global-exclude pyoccam/_[!_]*.py
exclude pyoccam/test*.py
exclude pyoccam/debug*.py
exclude pyoccam/*.py
include pyoccam/__init__.py

# Exclude everything else
global-exclude *.csv
global-exclude *.pyc
global-exclude __pycache__
prune .git
prune build
prune dist