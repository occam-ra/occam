libgcc_s_seh-1.dll
libstdc++-6.dll
libwinpthread-1.dll

# Backup files
*.bak
*.backup
*~
*.orig

# IMPORTANT EXCEPTIONS - Files to KEEP
!.gitignore
!README.md
!MANIFEST.in
!pyoccam/pyoccam_pybind11.cpp
!pyoccam/dementia05.txt
!pyoccam/landslides.txt
!pyoccam/pyoccam_demo.py
!pyoccam/pyoccam_demo.ipynb
!pyoccam/test_exact_server.py

# New build system files
!build_wheels.py
!pyoccam/__init__.py
!flask_app/**/*.py
!flask_app/occam_server/**/*.py
