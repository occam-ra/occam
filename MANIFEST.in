# Include documentation
include README.md
include LICENSE

# CRITICAL: Include ALL header files - use graft instead of recursive-include
graft include
graft cpp

# Also include the pyoccam source
include pyoccam/__init__.py
include pyoccam/pyoccam_pybind11.cpp
include pyoccam/*.txt
include pyoccam/*.py
include pyoccam/*.ipynb

# Include DLLs for Windows
include pyoccam/*.dll

# Exclude unwanted files
global-exclude *.pyc *.pyo *.pyd *.so *.o *.obj
global-exclude *~ *.bak* *.swp
global-exclude .DS_Store

# Exclude build directories
prune build
prune dist
prune .git
prune .github
prune *.egg-info
prune windows-wheels
prune __pycache__