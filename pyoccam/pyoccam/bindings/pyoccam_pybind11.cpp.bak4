// ========== DATA STRUCTURES ==========

struct PyModel {
    Model* model;
    std::string name;
    double h;
    double information;
    double aic;
    double bic;
    double daic;
    double dbic;
    double alpha;
    int df;
    double lr;
    double pct_correct_data;
    double incr_alpha;
    int level;
    
    PyModel() : model(nullptr), h(-1.0), information(-1.0), aic(-1.0), 
                bic(-1.0), daic(-1.0), dbic(-1.0), alpha(-1.0), 
                df(-1), lr(-1.0), pct_correct_data(-1.0), 
                incr_alpha(-1.0), level(0) {}
};

struct ConfusionMatrix {
    double tp, tn, fp, fn;
    double accuracy, sensitivity, specificity, precision, npv, f1_score;
    
    ConfusionMatrix() : tp(0), tn(0), fp(0), fn(0), accuracy(0),
                        sensitivity(0), specificity(0), precision(0),
                        npv(0), f1_score(0) {}
    
    void calculate_metrics() {
        double total = tp + tn + fp + fn;
        if (total > 0) {
            accuracy = (tp + tn) / total;
            sensitivity = (tp + fn > 0) ? tp / (tp + fn) : 0;
            specificity = (tn + fp > 0) ? tn / (tn + fp) : 0;
            precision = (tp + fp > 0) ? tp / (tp + fp) : 0;
            npv = (tn + fn > 0) ? tn / (tn + fn) : 0;
            f1_score = (precision + sensitivity > 0) ? 
                      2 * (precision * sensitivity) / (precision + sensitivity) : 0;
        }
    }
};

// ========== MAIN WRAPPER CLASS ==========

class PyVBMManager {
private:
    VBMManager manager;
    Report* report;
    std::map<std::string, Model*> best_models;
    std::set<std::string> seen_models;  // Track unique models
    std::vector<Model*> kept_models;    // Models actually kept in search
    bool debug_mode;
    
    // Configuration settings
    int report_separator;
    std::string report_variables;
    std::string ref_model;
    
    // ========== HELPER FUNCTIONS ==========
    
    std::pair<int, char**> python_list_to_argv(const std::vector<std::string>& args) {
        int argc = args.size();
        char** argv = new char*[argc];
        for (int i = 0; i < argc; i++) {
            argv[i] = new char[args[i].length() + 1];
            strcpy(argv[i], args[i].c_str());
        }
        return std::make_pair(argc, argv);
    }
    
    void cleanup_argv(int argc, char** argv) {
        for (int i = 0; i < argc; i++) {
            delete[] argv[i];
        }
        delete[] argv;
    }
    
    void computeModelStatistics(Model* model, Model* refModel) {
        manager.makeFitTable(model);
        manager.computeL2Statistics(model);
        manager.computeDependentStatistics(model);
        manager.computeInformationStatistics(model);
        manager.computePercentCorrect(model);
        
        if (refModel) {
            double daic = refModel->getAttribute("aic") - model->getAttribute("aic");
            double dbic = refModel->getAttribute("bic") - model->getAttribute("bic");
            model->setAttribute("daic", daic);
            model->setAttribute("dbic", dbic);
        }
    }
    
    PyModel create_fitted_model(Model* model) {
        if (!model) return PyModel();
        
        PyModel py_model;
        py_model.model = model;
        py_model.name = model->getPrintName();
        py_model.h = model->getAttribute("h");
        py_model.information = model->getAttribute("information");
        py_model.aic = model->getAttribute("aic");
        py_model.bic = model->getAttribute("bic");
        py_model.daic = model->getAttribute("daic");
        py_model.dbic = model->getAttribute("dbic");
        py_model.alpha = model->getAttribute("alpha");
        py_model.df = (int)model->getAttribute("ddf");
        py_model.lr = model->getAttribute("lr");
        py_model.pct_correct_data = model->getAttribute("pct_correct_data");
        py_model.incr_alpha = model->getAttribute("incr_alpha");
        py_model.level = (int)model->getAttribute("level");
        
        return py_model;
    }
    
    std::string captureOutput(std::function<void(FILE*)> func) {
        char tempname[L_tmpnam];
        tmpnam(tempname);
        FILE* temp = fopen(tempname, "w+");
        if (!temp) return "Error: Could not create temporary file";
        
        func(temp);
        
        rewind(temp);
        std::string output;
        char buffer[1024];
        while (fgets(buffer, sizeof(buffer), temp)) {
            output += buffer;
        }
        
        fclose(temp);
        remove(tempname);
        return output;
    }
    
    // Extract confusion matrix from conditional probability table
    ConfusionMatrix extractConfusionMatrixFromReport(const std::string& fit_report, 
                                                     const std::string& target_state) {
        ConfusionMatrix cm;
        
        // Parse the conditional probability table to calculate confusion matrix
        std::istringstream stream(fit_report);
        std::string line;
        bool in_conditional_table = false;
        
        // Track predictions vs actual
        double tp = 0, tn = 0, fp = 0, fn = 0;
        
        while (std::getline(stream, line)) {
            // Look for conditional DV table
            if (line.find("Conditional DV") != std::string::npos) {
                in_conditional_table = true;
                continue;
            }
            
            if (in_conditional_table && line.find("|") != std::string::npos) {
                // Skip header lines
                if (line.find("freq") != std::string::npos || 
                    line.find("obs.") != std::string::npos ||
                    line.find("calc.") != std::string::npos ||
                    line.find("IV") != std::string::npos) {
                    continue;
                }
                
                // Stop at table footer or summary line
                if (line.find("Rules marked") != std::string::npos ||
                    (line.find("|") != std::string::npos && line.find("424.000") != std::string::npos)) {
                    break;
                }
                
                // Parse data line - looking for pattern: | freq Z=0 Z=1 | ... rule ...
                std::vector<std::string> parts;
                std::istringstream lineStream(line);
                std::string part;
                while (lineStream >> part) {
                    parts.push_back(part);
                }
                
                // Find the pipe separators
                int pipe1 = -1, pipe2 = -1;
                for (size_t i = 0; i < parts.size(); i++) {
                    if (parts[i] == "|") {
                        if (pipe1 == -1) pipe1 = i;
                        else if (pipe2 == -1) pipe2 = i;
                    }
                }
                
                if (pipe1 >= 0 && pipe2 > pipe1 && parts.size() > pipe2 + 3) {
                    try {
                        // Extract frequency (right after first pipe)
                        double freq = std::stod(parts[pipe1 + 1]);
                        
                        // Extract actual percentages (Z=0 and Z=1)
                        double pct_z0 = std::stod(parts[pipe1 + 2]);
                        double pct_z1 = std::stod(parts[pipe1 + 3]);
                        
                        // Find rule value (after second pipe, skip calc values)
                        // Format: | calc_z0 calc_z1 rule ...
                        int rule = std::stoi(parts[pipe2 + 3]);
                        
                        // Calculate actual counts
                        double actual_z0 = freq * pct_z0 / 100.0;
                        double actual_z1 = freq * pct_z1 / 100.0;
                        
                        // Update confusion matrix based on rule and actual
                        // Rule 0 means predict Z=0 (negative), Rule 1 means predict Z=1 (positive)
                        if (rule == 0) {  // Predicted negative (Z=0)
                            tn += actual_z0;  // Actually Z=0, predicted Z=0 (True Negative)
                            fn += actual_z1;  // Actually Z=1, predicted Z=0 (False Negative)
                        } else {  // Predicted positive (Z=1)
                            fp += actual_z0;  // Actually Z=0, predicted Z=1 (False Positive)
                            tp += actual_z1;  // Actually Z=1, predicted Z=1 (True Positive)
                        }
                    } catch (...) {
                        // Skip lines that don't parse correctly
                        continue;
                    }
                }
            }
        }
        
        // Round to nearest integer for cleaner display
        cm.tp = std::round(tp);
        cm.tn = std::round(tn);
        cm.fp = std::round(fp);
        cm.fn = std::round(fn);
        
        // Calculate metrics
        cm.calculate_metrics();
        
        return cm;
    }
    
public:
    PyVBMManager() : report(nullptr), debug_mode(false), 
                     report_separator(3), ref_model("bottom") {
        // Initialize with simpler column spec to avoid Report class issues
        // Let Report handle ID and Model automatically
        report_variables = "Level$I, h, ddf, dLR, Alpha, Inf, %dH(DV), dAIC, dBIC";
    }
    
    ~PyVBMManager() {
        if (report) delete report;
    }
    
    // ========== INITIALIZATION ==========
    
    bool init_from_command_line(const std::vector<std::string>& args) {
        auto argv_pair = python_list_to_argv(args);
        bool result = manager.initFromCommandLine(argv_pair.first, argv_pair.second);
        cleanup_argv(argv_pair.first, argv_pair.second);
        
        if (result) {
            report = new Report(&manager);
            report->setSeparator(report_separator);
        }
        return result;
    }
    
    // ========== CONFIGURATION METHODS ==========
    
    void set_report_separator(int separator) {
        report_separator = separator;
        if (report) {
            report->setSeparator(separator);
        }
    }
    
    void set_report_variables(const std::string& variables) {
        // Clean up the variables string to work better with Report class
        report_variables = variables;
        
        // If user provides full spec with ID and Model, simplify it
        // Report class handles ID and Model automatically
        if (variables.find("ID$I, Model,") != std::string::npos) {
            // Remove "ID$I, Model," from the beginning
            size_t pos = variables.find("Level");
            if (pos != std::string::npos) {
                report_variables = variables.substr(pos);
            } else {
                // Use default if can't parse
                report_variables = "Level$I, h, ddf, dLR, Alpha, Inf, %dH(DV), dAIC, dBIC";
            }
        }
        
        if (report) {
            report->setAttributes(const_cast<char*>(report_variables.c_str()));
        }
    }
    
    void set_ref_model(const std::string& model) {
        ref_model = model;
        manager.setRefModel(const_cast<char*>(model.c_str()));
    }
    
    void set_search_type(const std::string& search_type) {
        manager.setSearch(search_type.c_str());
    }
    
    void set_debug_mode(bool debug) {
        debug_mode = debug;
    }
    
    // ========== ENHANCED SEARCH WITH DEDUPLICATION ==========
    
// CORRECT implementation for generate_search_report
// Tracks best models across ALL levels, not just kept models

// Fixed generate_search_report without std::cout
// Fixed generate_search_report without std::cout
	std::string generate_search_report(const std::string& search_type, int levels, int width, 
									  bool include_test_data = false) {
		
		// Initialize search
		manager.setSearch(search_type.c_str());
		SearchBase* search = manager.getSearch();
		if (!search) {
			return "Error: Invalid search type";
		}
		
		// Get reference model
		Model* refModel = manager.getBottomRefModel();
		if (!refModel) {
			return "Error: No reference model";
		}
		
		// ALL models evaluated during search (across all levels)
		std::vector<Model*> all_models_evaluated;
		
		// Models to expand at each level
		std::vector<Model*> current_level = {refModel};
		
		// Track unique models
		std::set<std::string> seen_models;
		
		// Store search progress for report
		std::ostringstream search_progress;
		
		// Add reference model
		all_models_evaluated.push_back(refModel);
		refModel->setAttribute("level", 0.0);
		refModel->setAttribute("daic", 0.0);
		refModel->setAttribute("dbic", 0.0);
		refModel->setAttribute("information", 0.0);
		
		// Statistics for search progress output
		int total_models = 1;
		int total_kept = 1;
		
		// Search progress header (optional - can include in report)
		search_progress << "Searching levels:\n";
		
		// Search each level
		for (int level = 1; level <= levels; level++) {
			std::vector<Model*> models_at_this_level;
			int new_models_count = 0;
			
			// Generate children from all parents at current level
			for (Model* parent : current_level) {
				Model** children = search->search(parent);
				if (!children) continue;
				
				for (int i = 0; children[i] != nullptr; i++) {
					Model* child = children[i];
					std::string model_name = child->getPrintName();
					
					// Skip duplicates (ModelCache should handle this but be safe)
					if (seen_models.find(model_name) != seen_models.end()) {
						continue;
					}
					seen_models.insert(model_name);
					new_models_count++;
					
					// Compute all statistics for this model
					manager.makeFitTable(child);
					manager.computeL2Statistics(child);
					manager.computeDependentStatistics(child);
					manager.computeInformationStatistics(child);
					manager.computePercentCorrect(child);
					
					// Calculate dAIC and dBIC (positive = better than reference)
					double child_aic = child->getAttribute("aic");
					double child_bic = child->getAttribute("bic");
					double ref_aic = refModel->getAttribute("aic");
					double ref_bic = refModel->getAttribute("bic");
					
					// OCCAM convention: positive difference = improvement
					double daic = ref_aic - child_aic;
					double dbic = ref_bic - child_bic;
					
					child->setAttribute("daic", daic);
					child->setAttribute("dbic", dbic);
					child->setAttribute("level", (double)level);
					
					// Add to this level's models
					models_at_this_level.push_back(child);
					
					// CRITICAL: Add to ALL models list for best tracking
					all_models_evaluated.push_back(child);
				}
			}
			
			// Sort models at this level by dBIC (or configured sort criterion)
			std::sort(models_at_this_level.begin(), models_at_this_level.end(),
					 [](Model* a, Model* b) {
						 return a->getAttribute("dbic") > b->getAttribute("dbic");
					 });
			
			// Select top 'width' models for next level
			current_level.clear();
			int kept_count = std::min(width, (int)models_at_this_level.size());
			for (int i = 0; i < kept_count; i++) {
				current_level.push_back(models_at_this_level[i]);
			}
			
			// Update statistics
			total_models += new_models_count;
			total_kept += kept_count;
			
			// Store search progress (instead of cout)
			search_progress << level << " : " << new_models_count << " new models, " 
						   << kept_count << " kept; " << total_models << " total models, "
						   << total_kept << " total kept\n";
		}
		
		// CRITICAL: Find best models from ALL evaluated models
		Model* best_bic_model = nullptr;
		Model* best_aic_model = nullptr;
		Model* best_info_model = nullptr;
		double best_dbic = -999999.0;
		double best_daic = -999999.0;
		double best_info = -999999.0;
		
		for (Model* model : all_models_evaluated) {
			double dbic = model->getAttribute("dbic");
			double daic = model->getAttribute("daic");
			double info = model->getAttribute("information");
			
			if (dbic > best_dbic) {
				best_dbic = dbic;
				best_bic_model = model;
			}
			if (daic > best_daic) {
				best_daic = daic;
				best_aic_model = model;
			}
			if (info > best_info) {
				best_info = info;
				best_info_model = model;
			}
		}
		
		// Store for later retrieval by get_best_model_by_* methods
		this->best_models.clear();
		if (best_bic_model) this->best_models["bic"] = best_bic_model;
		if (best_aic_model) this->best_models["aic"] = best_aic_model;
		if (best_info_model) this->best_models["information"] = best_info_model;
		
		// Sort all models for report (by information ascending for ID assignment)
		std::sort(all_models_evaluated.begin(), all_models_evaluated.end(),
				 [](Model* a, Model* b) {
					 return a->getAttribute("information") < b->getAttribute("information");
				 });
		
		// Format the report
		std::ostringstream report;
		
		// Optional: Include search progress at top
		if (debug_mode) {
			report << search_progress.str() << "\n";
		}
		
		// Header with proper spacing (matching server format)
		// Adjust spacing to match the PDF exactly
		report << std::setw(4) << std::right << "ID"
			   << "   " << std::setw(17) << std::left << "MODEL"
			   << std::setw(8) << std::right << "Level"
			   << std::setw(10) << std::right << "H"
			   << std::setw(11) << std::right << "dDF"
			   << std::setw(11) << std::right << "dLR"
			   << std::setw(10) << std::right << "Alpha"
			   << std::setw(12) << std::right << "Inf"
			   << std::setw(10) << std::right << "%dH(DV)"
			   << std::setw(11) << std::right << "dAIC"
			   << std::setw(11) << std::right << "dBIC"
			   << "\n";
		
		// Output models (highest ID = lowest information, matching server)
		int id = all_models_evaluated.size();
		for (Model* model : all_models_evaluated) {
			std::string name = model->getPrintName();
			int level = (int)model->getAttribute("level");
			double h = model->getAttribute("h");
			double ddf = model->getAttribute("ddf");
			double dlr = model->getAttribute("dlr");
			double alpha = model->getAttribute("alpha");
			double info = model->getAttribute("information");
			double info_pct = info * 100.0;  // Convert to percentage
			double daic = model->getAttribute("daic");
			double dbic = model->getAttribute("dbic");
			
			// Check if this is a best model (mark with asterisk)
			bool is_best = (model == best_bic_model || 
						   model == best_aic_model || 
						   model == best_info_model);
			
			// Format ID with possible asterisk
			report << std::setw(3) << std::right << id;
			if (is_best) {
				report << "*";
			} else {
				report << " ";
			}
			
			// Model name (left aligned)
			report << "  " << std::setw(17) << std::left << name;
			
			// Level (integer, right aligned)
			report << std::setw(8) << std::right << level;
			
			// Statistics with proper precision
			report << std::fixed;
			
			// H value
			report << std::setprecision(4) << std::setw(10) << std::right << h;
			
			// dDF (as integer for large values)
			report << std::setw(11) << std::right << (long)ddf;
			
			// dLR
			report << std::setprecision(4) << std::setw(11) << std::right << dlr;
			
			// Alpha
			report << std::setprecision(4) << std::setw(10) << std::right << alpha;
			
			// Information (show full precision)
			report << std::setprecision(8) << std::setw(12) << std::right << info;
			
			// %dH(DV) - information as percentage
			report << std::setprecision(4) << std::setw(10) << std::right << info_pct;
			
			// dAIC and dBIC
			report << std::setprecision(4) << std::setw(11) << std::right << daic;
			report << std::setprecision(4) << std::setw(11) << std::right << dbic;
			
			report << "\n";
			id--;
		}
		
		// Repeat header
		report << std::setw(4) << std::right << "ID"
			   << "   " << std::setw(17) << std::left << "MODEL"
			   << std::setw(8) << std::right << "Level"
			   << std::setw(10) << std::right << "H"
			   << std::setw(11) << std::right << "dDF"
			   << std::setw(11) << std::right << "dLR"
			   << std::setw(10) << std::right << "Alpha"
			   << std::setw(12) << std::right << "Inf"
			   << std::setw(10) << std::right << "%dH(DV)"
			   << std::setw(11) << std::right << "dAIC"
			   << std::setw(11) << std::right << "dBIC"
			   << "\n\n";
		
		// Best models section (simplified format matching PDF)
		report << "Best Model(s) by dBIC:\n";
		if (best_bic_model) {
			// Find ID
			int best_id = 0;
			for (size_t i = 0; i < all_models_evaluated.size(); i++) {
				if (all_models_evaluated[i] == best_bic_model) {
					best_id = all_models_evaluated.size() - i;
					break;
				}
			}
			report << std::setw(3) << best_id << "*  " 
				   << std::setw(17) << std::left << best_bic_model->getPrintName()
				   << " (Level " << (int)best_bic_model->getAttribute("level") 
				   << ", dBIC=" << std::fixed << std::setprecision(4) 
				   << best_bic_model->getAttribute("dbic") << ")\n";
		}
		
		report << "Best Model(s) by dAIC:\n";
		if (best_aic_model) {
			int best_id = 0;
			for (size_t i = 0; i < all_models_evaluated.size(); i++) {
				if (all_models_evaluated[i] == best_aic_model) {
					best_id = all_models_evaluated.size() - i;
					break;
				}
			}
			report << std::setw(3) << best_id << "   " 
				   << std::setw(17) << std::left << best_aic_model->getPrintName()
				   << " (Level " << (int)best_aic_model->getAttribute("level")
				   << ", dAIC=" << std::fixed << std::setprecision(4) 
				   << best_aic_model->getAttribute("daic") << ")\n";
		}
		
		report << "Best Model(s) by Information:\n";
		if (best_info_model) {
			int best_id = 0;
			for (size_t i = 0; i < all_models_evaluated.size(); i++) {
				if (all_models_evaluated[i] == best_info_model) {
					best_id = all_models_evaluated.size() - i;
					break;
				}
			}
			report << std::setw(3) << best_id << "*  " 
				   << std::setw(17) << std::left << best_info_model->getPrintName()
				   << " (Level " << (int)best_info_model->getAttribute("level")
				   << ", Info=" << std::fixed << std::setprecision(8) 
				   << best_info_model->getAttribute("information") << ")\n";
		}
		
		return report.str();
	}
    
    // ========== ENHANCED FIT REPORT ==========
    
    std::string generate_fit_report(const std::string& model_name, 
                                    const std::string& target_state = "") {
        Model* model = manager.makeModel(model_name.c_str(), true);
        if (!model) return "Error: Invalid model name";
        
        computeModelStatistics(model, manager.getBottomRefModel());
        
        // Get basic fit report
        std::string report_str = captureOutput([this, model](FILE* f) {
            manager.printFitReport(model, f);
        });
        
        // Add conditional probability tables
        if (report) {
            report_str += "\n\n========== CONDITIONAL PROBABILITY TABLES ==========\n\n";
            
            report_str += captureOutput([this, model, &target_state](FILE* f) {
                report->printConditional_DV(f, model, false, 
                                          const_cast<char*>(target_state.c_str()));
            });
            
            // Component relations
            int relationCount = model->getRelationCount();
            if (relationCount > 2) {
                report_str += "\n\n========== COMPONENT RELATIONS ==========\n\n";
                
                for (int i = 0; i < relationCount; i++) {
                    Relation* rel = model->getRelation(i);
                    if (rel) {
                        report_str += "\nRelation: " + std::string(rel->getPrintName()) + "\n";
                        report_str += captureOutput([this, rel, &target_state](FILE* f) {
                            report->printConditional_DV(f, rel, false,
                                                      const_cast<char*>(target_state.c_str()));
                        });
                    }
                }
            }
        }
        
        // Add confusion matrix with better extraction
        if (!target_state.empty()) {
            report_str += "\n\n========== CONFUSION MATRIX ==========\n\n";
            
            // Extract from the conditional probability table
            ConfusionMatrix cm = extractConfusionMatrixFromReport(report_str, target_state);
            
            report_str += "Confusion Matrix for Model " + model_name + "\n";
            report_str += "Default (negative) state: " + target_state + "\n\n";
            
            report_str += "              Predicted\n";
            report_str += "              Negative  Positive\n";
            report_str += "Actual Negative  " + std::to_string((int)cm.tn) + "      " + 
                         std::to_string((int)cm.fp) + "\n";
            report_str += "       Positive  " + std::to_string((int)cm.fn) + "      " + 
                         std::to_string((int)cm.tp) + "\n\n";
            
            report_str += "Statistics:\n";
            report_str += "  Accuracy:    " + std::to_string(cm.accuracy) + "\n";
            report_str += "  Sensitivity: " + std::to_string(cm.sensitivity) + "\n";
            report_str += "  Specificity: " + std::to_string(cm.specificity) + "\n";
            report_str += "  Precision:   " + std::to_string(cm.precision) + "\n";
            report_str += "  NPV:         " + std::to_string(cm.npv) + "\n";
            report_str += "  F1 Score:    " + std::to_string(cm.f1_score) + "\n";
        }
        
        return report_str;
    }
    
    // ========== BEST MODEL GETTERS (WORKING!) ==========
    
    std::string get_best_model_by_bic() {
        if (best_models.count("bic")) {
            return best_models["bic"]->getPrintName();
        }
        return "";
    }
    
    std::string get_best_model_by_aic() {
        if (best_models.count("aic")) {
            return best_models["aic"]->getPrintName();
        }
        return "";
    }
    
    std::string get_best_model_by_information() {
        if (best_models.count("information")) {
            return best_models["information"]->getPrintName();
        }
        return "";
    }
    
    // ========== MODEL OPERATIONS ==========
    
    PyModel make_model(const std::string& model_name, bool make_fit_table = false) {
        Model* model = manager.makeModel(model_name.c_str(), make_fit_table);
        if (!model) return PyModel();
        
        if (make_fit_table) {
            computeModelStatistics(model, manager.getBottomRefModel());
        }
        
        return create_fitted_model(model);
    }
    
    PyModel get_model_statistics(const std::string& model_name) {
        return make_model(model_name, true);
    }
    
    // ========== INFORMATION GETTERS ==========
    
    std::vector<std::string> get_variable_list() {
        std::vector<std::string> vars;
        VariableList* varList = manager.getVariableList();
        if (varList) {
            for (int i = 0; i < varList->getVarCount(); i++) {
                Variable* var = varList->getVariable(i);
                if (var) {
                    vars.push_back(var->abbrev);
                }
            }
        }
        return vars;
    }
    
    std::string get_basic_statistics() {
        return captureOutput([this](FILE* f) {
            manager.printBasicStatistics();
        });
    }
    
    double get_sample_size() {
        return manager.getSampleSz();
    }
    
    bool has_test_data() {
        return manager.getTestSampleSize() > 0;
    }
    
    std::vector<std::string> get_available_search_types() {
        return {
            "loopless-up", "loopless-down",
            "full-up", "full-down",
            "disjoint-up", "disjoint-down",
            "chain-up", "chain-down"
        };
    }
    
    py::dict get_confusion_matrix(const std::string& model_name, const std::string& target_state) {
        // Generate fit report and extract confusion matrix
        std::string fit_report = generate_fit_report(model_name, target_state);
        ConfusionMatrix cm = extractConfusionMatrixFromReport(fit_report, target_state);
        
        py::dict result;
        result["tp"] = cm.tp;
        result["tn"] = cm.tn;
        result["fp"] = cm.fp;
        result["fn"] = cm.fn;
        result["accuracy"] = cm.accuracy;
        result["sensitivity"] = cm.sensitivity;
        result["specificity"] = cm.specificity;
        result["precision"] = cm.precision;
        result["npv"] = cm.npv;
        result["f1_score"] = cm.f1_score;
        
        return result;
    }
};

// ========== PYBIND11 MODULE DEFINITION ==========

PYBIND11_MODULE(pyoccam, m) {
    m.doc() = "OCCAM Python bindings - Enhanced complete implementation";
    
    // PyModel class
    py::class_<PyModel>(m, "Model")
        .def(py::init<>())
        .def_readwrite("name", &PyModel::name)
        .def_readwrite("h", &PyModel::h)
        .def_readwrite("information", &PyModel::information)
        .def_readwrite("aic", &PyModel::aic)
        .def_readwrite("bic", &PyModel::bic)
        .def_readwrite("daic", &PyModel::daic)
        .def_readwrite("dbic", &PyModel::dbic)
        .def_readwrite("alpha", &PyModel::alpha)
        .def_readwrite("df", &PyModel::df)
        .def_readwrite("lr", &PyModel::lr)
        .def_readwrite("pct_correct_data", &PyModel::pct_correct_data)
        .def_readwrite("incr_alpha", &PyModel::incr_alpha)
        .def_readwrite("level", &PyModel::level);
    
    // PyVBMManager class with all methods
    py::class_<PyVBMManager>(m, "VBMManager")
        .def(py::init<>())
        
        // Initialization
        .def("init_from_command_line", &PyVBMManager::init_from_command_line,
             "Initialize OCCAM from command line arguments")
        
        // Configuration - NOW ALL WORKING!
        .def("set_report_separator", &PyVBMManager::set_report_separator,
             "Set report separator (1=tab, 2=comma, 3=space, 4=HTML)")
        .def("set_report_variables", &PyVBMManager::set_report_variables,
             "Set variables to display in reports")
        .def("set_ref_model", &PyVBMManager::set_ref_model,
             "Set reference model for statistics")
        .def("set_search_type", &PyVBMManager::set_search_type,
             "Set search algorithm type")
        .def("set_debug_mode", &PyVBMManager::set_debug_mode,
             "Enable/disable debug mode")
        
        // Main operations - ENHANCED!
        .def("generate_search_report", &PyVBMManager::generate_search_report,
             "Generate search report with automatic deduplication and best model tracking",
             py::arg("search_type"), py::arg("levels"), py::arg("width"), 
             py::arg("include_test_data") = false)
        .def("generate_fit_report", &PyVBMManager::generate_fit_report,
             "Generate fit report with conditional tables and confusion matrix",
             py::arg("model_name"), py::arg("target_state") = "")
        
        // Best model getters - FULLY WORKING!
        .def("get_best_model_by_bic", &PyVBMManager::get_best_model_by_bic,
             "Get name of best model by BIC from last search")
        .def("get_best_model_by_aic", &PyVBMManager::get_best_model_by_aic,
             "Get name of best model by AIC from last search")
        .def("get_best_model_by_information", &PyVBMManager::get_best_model_by_information,
             "Get name of best model by information from last search")
        
        // Model operations
        .def("make_model", &PyVBMManager::make_model,
             "Create and optionally fit a model",
             py::arg("model_name"), py::arg("make_fit_table") = false)
        .def("get_model_statistics", &PyVBMManager::get_model_statistics,
             "Get statistics for a specific model")
        
        // Confusion matrix access
        .def("get_confusion_matrix", &PyVBMManager::get_confusion_matrix,
             "Get confusion matrix for a model",
             py::arg("model_name"), py::arg("target_state"))
        
        // Information getters
        .def("get_variable_list", &PyVBMManager::get_variable_list,
             "Get list of variable names")
        .def("get_basic_statistics", &PyVBMManager::get_basic_statistics,
             "Get basic statistics as string")
        .def("get_sample_size", &PyVBMManager::get_sample_size,
             "Get sample size")
        .def("has_test_data", &PyVBMManager::has_test_data,
             "Check if test data is available")
        .def("get_available_search_types", &PyVBMManager::get_available_search_types,
             "Get list of available search types");
    
    // Constants
    m.attr("TABSEP") = 1;
    m.attr("COMMASEP") = 2;
    m.attr("SPACESEP") = 3;
    m.attr("HTMLFORMAT") = 4;
    
    m.attr("__version__") = "3.4.0";
}
