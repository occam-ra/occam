# OCCAM Flask Server - Environment Configuration Example
# Copy this file to .env and configure for your environment

# Redis Configuration
# Default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Email/SMTP Configuration for Batch Job Notifications
# These are required if you want email notifications when batch jobs complete

# SMTP server hostname
SMTP_HOST=localhost

# SMTP server port (25 for plain SMTP, 587 for TLS, 465 for SSL)
SMTP_PORT=25

# SMTP authentication credentials (leave empty if not required)
SMTP_USER=
SMTP_PASSWORD=

# From address for notification emails
SMTP_FROM=noreply@occam.local

# Flask Configuration (optional)
# FLASK_ENV=development
# FLASK_DEBUG=1
