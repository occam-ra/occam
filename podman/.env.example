# OCCAM Web Server Container - Environment Configuration
# Copy this file to .env and configure for your environment

# SMTP Configuration for Email Notifications
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@occam.local

# Gunicorn Configuration
GUNICORN_WORKERS=4
GUNICORN_RELOAD=false

# Logging
LOG_LEVEL=info

# Note: REDIS_URL is configured internally and doesn't need to be changed
# unless using an external Redis instance
