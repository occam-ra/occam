# MANIFEST.in - Ensure all source files are included in sdist

# Documentation
include README.md
include LICENSE

# CRITICAL: Include all C++ source and header files
recursive-include cpp *.cpp *.h
recursive-include include *.h

# Include the pybind11 wrapper
include pyoccam/pyoccam_pybind11.cpp

# Include data files and demos
include pyoccam/__init__.py
include pyoccam/dementia05.txt
include pyoccam/landslides.txt
include pyoccam/pyoccam_demo.py
include pyoccam/pyoccam_demo.ipynb

# Include MinGW DLLs for Windows
include pyoccam/*.dll

# Exclude compiled and temporary files
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude *.so
global-exclude *.o
global-exclude *.obj
global-exclude *~
global-exclude *.bak

# Exclude test/debug scripts
global-exclude debug_*.py
global-exclude test_*.py
global-exclude check_*.py
global-exclude diagnose_*.py
global-exclude examine_*.py
global-exclude find_*.py
global-exclude final_*.py

# Exclude output files
global-exclude *.csv

# Exclude build artifacts
prune build
prune dist
prune *.egg-info
prune __pycache__
prune .git
prune .github
prune windows-wheels